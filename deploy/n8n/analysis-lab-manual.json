        "url": "http://trizbackend.railway.internal:8000/internal/lab/begin",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 3600000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "TRIZStudioV2Auth",
          "name": "TRIZ Studio Service"
        }
      },
      "retryOnFail": false,
      "notes": "기존 MCP 서버의 triz_lab_execute를 사용합니다. 새 분석을 만들거나 현재 확인 응답을 반영하고 다음 stage만 결정합니다. 운영 run을 생성하지 않습니다.",
      "notesInFlow": true
    },
