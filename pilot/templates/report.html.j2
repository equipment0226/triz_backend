<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ v.title }} · TRIZ 보고서</title>
<style>body{font-family:system-ui,sans-serif;color:#243e43;background:#eff4f2;margin:0;line-height:1.8}main{max-width:1100px;margin:auto;padding:60px 30px}h1{font-size:38px;line-height:1.3}h2{margin-top:50px}section,figure{background:white;border:1px solid #dce6e0;border-radius:18px;padding:28px;margin:20px 0}figure svg{display:block;width:100%;height:auto;max-height:none}td,th,p,li{overflow-wrap:anywhere}table{table-layout:fixed}section{overflow:visible}h3{margin-top:32px}a{color:#167261}p{white-space:pre-line}.badge{color:#197562}table{border-collapse:collapse;width:100%}td,th{text-align:left;padding:10px;border-bottom:1px solid #ddd}.person{display:inline-block;background:#e7f0ec;border-radius:12px;padding:12px;margin:6px}@media print{body{background:white}main{padding:0}section,figure{break-inside:avoid}a{color:inherit}} </style></head><body><main>
<p class="badge">TRIZ · PROJECT REPORT</p><h1>{{ v.title }}</h1><p>{{ v.industry }} · {{ v.system }}</p><p>{{ v.summary or v.problem }}</p>
<h2>해결안 비교</h2><table><tr><th>해결안</th><th>평가</th><th>제약</th></tr>{% for c in v.solutions %}<tr><td>{{ c.title }}</td><td>{{ c.score if c.score is not none else '검토 전' }}</td><td>{{ c.verdict }}</td></tr>{% endfor %}</table>
{% for section in v.report_sections %}<section><h2>{{ section.title }}</h2>{{ section.html | safe }}{% for f in section.figures %}<figure>{{ f.svg | safe }}<figcaption>{{ f.title }}</figcaption></figure>{% endfor %}</section>{% endfor %}
<h2>해결안 상세</h2>{% for c in v.solutions %}<section><h3>{{ loop.index }}. {{ c.title }}</h3><p>{{ c.description }}</p><p><b>동작 원리</b> {{ c.mechanism }}</p><p><b>기대 효과와 가정</b> {{ c.effect }}</p><ul>{% for r in c.risks %}<li>{{ r }}</li>{% endfor %}</ul><h4>검증 계획</h4>{% for t in c.validation %}<p>{{ t.get('metric','') }} · {{ t.get('experiment','') }} · 반증 기준: {{ t.get('failure_criterion','') }}</p>{% else %}<p>검증 계획 보완 필요</p>{% endfor %}<p>{{ c.transfer_conditions | join(' / ') }}</p><h4>특허·논문</h4>{% for e in c.evidence %}<p>{{ e.kind }} · <a href="{{ e.url }}" rel="noopener noreferrer">{{ e.title }}</a><br>{{ e.scope }}<br>기능 대응: {{ e.mechanism }}</p>{% endfor %}{% for related in v.related_references if related.concept_id == c.key %}<p>{{ related.status }} · <a href="{{ related.reference.url }}">{{ related.reference.title }}</a><br>{{ related.reason }}</p>{% endfor %}{% for gap in v.evidence_gaps if gap.title == c.title %}<p>근거 추가 확보 필요: {{ gap.missing | join(', ') }}</p>{% endfor %}</section>{% endfor %}
<h2>추가 검증 후보</h2>{% for c in v.additions %}<section><h3>{{ c.title }}</h3><p>{{ c.how_it_differs }}</p><p>{{ c.status }}</p><p>{{ c.transfer_conditions | join(' / ') }}</p><a href="{{ c.reference.url }}">{{ c.reference.title }}</a></section>{% else %}<p>추가 후보를 확인하지 못했습니다.</p>{% endfor %}
<h2>전문가 검토</h2>{% for p in v.reviewers %}<div class="person">👤 {{ p.role }}<br>{{ p.mandate }}</div>{% endfor %}<h2>제약 조건</h2><ul>{% for c in v.constraints %}<li>{{ c }}</li>{% endfor %}</ul><h2>검증 현황</h2><p>정상 처리 {{ v.review_status.checked }}개 · 추가 검토 {{ v.review_status.unverified }}개</p>{% for w in v.warnings %}<p>{{ w }}</p>{% endfor %}</main></body></html>
