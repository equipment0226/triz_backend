# Separate patent profile. Nothing here changes the TRIZ model or project budget.
# Copy explicitly into the backend environment; this file is never auto-loaded.
PATENT_ENABLED=false
PATENT_DISPATCH_ENABLED=false
PATENT_WORKER_ENABLED=false
PATENT_MCP_ENABLED=false
PATENT_SERVICE_TOKEN=
