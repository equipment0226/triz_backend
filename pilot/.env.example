# Local development: no hosted credentials are included.
APP_HOST=127.0.0.1
APP_PORT=8000
ORCHESTRATOR=local
DATABASE_URL=
DB_PATH=./data/triz.db
STORAGE_DIR=./data/storage

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_T1=deepseek-chat
LLM_MODEL_T2=deepseek-chat
LLM_MODEL_T3=deepseek-chat
# T1 extraction; T2 high-performance reasoning; T3 independent review.
LLM_API_KEY_T2=
LLM_BASE_URL_T2=
LLM_MAX_TOKENS_T1=2400
LLM_MAX_TOKENS_T2=6500
LLM_MAX_TOKENS_T3=1800
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SEC=180

TRIZ_SERVICE_TOKEN=
TRIZ_MCP_URL=http://127.0.0.1:8001/mcp
N8N_DISPATCH_URL=http://127.0.0.1:5678/webhook/triz-dispatch
MCP_HOST=127.0.0.1
MCP_PORT=8001
TRIZ_MCP_MODULE=all
EVIDENCE_PROVIDERS=crossref,arxiv,patentsview,tavily
PATENTSVIEW_API_KEY=
# Runtime search uses Qdrant + dedicated patent MySQL; no BigQuery fallback.
PATENT_SEARCH_PROVIDER=vector
PATENT_DATABASE_URL=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
PATENT_VECTOR_COLLECTION=patents_e5_small_v1
PATENT_DB_MAX_BYTES=200000000000
PATENT_VECTOR_MAX_POINTS=10000000
PATENT_EMBEDDING_THREADS=2
PATENT_SEARCH_TIMEOUT_SECONDS=20
PATENT_MIN_SCORE=0.75
BIGQUERY_PROJECT_ID=
BIGQUERY_LOCATION=US
# Service-account JSON, not Google login OAuth credentials. Keep out of Git.
GOOGLE_SERVICE_ACCOUNT_JSON=
BIGQUERY_MAX_BYTES_BILLED=274877906944
BIGQUERY_MONTHLY_BYTE_LIMIT=824633720832
BIGQUERY_TIMEOUT_SECONDS=90
BIGQUERY_CACHE_SECONDS=86400
TAVILY_API_KEY=
MAX_UPLOAD_MB=25
OCR_LANG=eng
