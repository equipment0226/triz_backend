PATENT_T1_OUTPUT_USD_PER_M=1.2
PATENT_T1_INPUT_LIMIT=262144
PATENT_T1_OUTPUT_LIMIT=8192
PATENT_T1_REASONING=false
PATENT_T2_MODEL=deepseek-flash
PATENT_T2_BASE_URL=https://api.deepseek.com/v1
