<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ v.title }} · TRIZ 보고서</title><style>body{font-family:system-ui,sans-serif;color:#243e43;background:#eff4f2;margin:0;line-height:1.8}main{max-width:1100px;margin:auto;padding:60px 30px}h1{font-size:38px;line-height:1.3}h2{margin-top:40px}section,figure{background:white;border:1px solid #dce6e0;border-radius:18px;padding:28px;margin:20px 0;min-width:0}figure svg{display:block;width:100%;height:auto;max-height:none}td,th,p,li{overflow-wrap:anywhere}table{border-collapse:collapse;table-layout:fixed;width:100%;margin:20px 0}td,th{text-align:center;vertical-align:middle;padding:12px;border:1px solid #dde5e1;font-size:13px}th{background:#eef5f1}.report-matrix th,.report-matrix td{text-align:center;padding:8px 4px}.figure-compact{max-width:860px;margin-left:auto;margin-right:auto}.figure-note{text-align:center;font-size:12px;line-height:1.7;color:#657879}.report-term{font-weight:700}h3{margin-top:32px}a{color:#167261}.badge{color:#197562}.reference-card{margin:22px 0;overflow-wrap:anywhere}.reference-title{display:block;font-size:17px;line-height:1.6;font-weight:500}.reference-kind{font-size:12px;margin-right:6px}.reference-description{font-size:13px;line-height:1.8;color:#526b67;margin:10px 0}.reference-status,.reference-meta{font-size:12px;line-height:1.6;color:#687c76;margin:8px 0}@media(max-width:700px){main{padding:20px 12px}section,figure{padding:14px}h1{font-size:28px}td,th{padding:6px;font-size:11px}}@media print{figure:has(svg[data-diagram="standard-application"]){padding:12px;margin:12px 0}svg[data-diagram="standard-application"]{max-height:205mm}figure:has(svg[data-diagram="standard-application"]) figcaption{font-size:12px;line-height:1.5}body{background:white}main{padding:0}figure{break-inside:avoid}h2,h3,h4{break-after:avoid}a{color:inherit}}</style></head><body><main>
<p class="badge">TRIZ · PROJECT REPORT</p><h1>{{ v.title }}</h1><p>{{ v.industry }} · {{ v.system }}</p><p>{{ v.summary or v.problem }}</p>
{% for section in v.report_sections %}<section><h2>{{ section.title }}</h2>
{% for block in section.blocks %}{% if block.type == 'figure' %}<figure{% if block.figure.compact %} class="figure-compact"{% endif %}>{{ block.figure.svg | safe }}<figcaption>{{ block.figure.title }}</figcaption>{% if block.figure.note %}<p class="figure-note">{{ block.figure.note }}</p>{% endif %}</figure>{% else %}{{ block.html | safe }}{% endif %}{% endfor %}
</section>{% endfor %}
</main></body></html>
